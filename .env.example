# MySQL connection used by Prisma (server/prisma/schema.prisma)
DATABASE_URL="mysql://root:password@localhost:3306/ashapura_quotation"

# JWT signing secret (generate a long random string for real use)
JWT_SECRET="change-me-to-a-long-random-string"

# Port the Express API listens on
PORT=4000

# Base URL the client uses to reach the API in dev
VITE_API_BASE_URL="http://localhost:4000"
