{
  "name": "ashapura-quotation",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build:calc-engine": "npm run build --workspace @ashapura/calc-engine",
    "build:server": "npm run build --workspace server",
    "build:client": "npm run build --workspace client",
    "test:calc-engine": "npm test --workspace @ashapura/calc-engine",
    "prisma:generate": "npm run prisma:generate --workspace server",
    "prisma:migrate": "npm run prisma:migrate --workspace server",
    "prisma:seed": "npm run prisma:seed --workspace server",
    "build": "npm run build:calc-engine && npm run build:client && npm run build:server",
    "start": "npm run start --workspace server"
  }
}
