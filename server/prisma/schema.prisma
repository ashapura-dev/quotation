generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  SUPER_ADMIN
  EMPLOYEE
  TL
}

enum QuotationType {
  DPD
  NON_DPD
}

enum ComponentType {
  FIXED
  PERCENTAGE
  PER_CONTAINER
  TEXT
}

enum QuotationStatus {
  DRAFT
  PENDING
  APPROVED
  SENT_TO_CLIENT
  APPROVED_BY_CLIENT
  REJECTED_BY_CLIENT
}

enum NotificationType {
  SUBMITTED_FOR_REVIEW
  APPROVED
  REJECTED
  SENT_TO_CLIENT
  APPROVED_BY_CLIENT
  REJECTED_BY_CLIENT
}

// ---------- Users ----------

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdClients      Client[]
  createdRateTemplates RateTemplate[]
  createdPdfTemplates PdfTemplate[]
  createdQuotations   Quotation[]        @relation("QuotationCreatedBy")
  approvedQuotations  Quotation[]        @relation("QuotationApprovedBy")
  statusChanges       QuotationStatusHistory[]
  notifications       Notification[]

  @@map("users")
}

// ---------- Master data ----------

model ContainerSize {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  label     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  containerRates      RateTemplateContainerRate[]
  quotationContainers QuotationContainer[]

  @@map("container_sizes")
}

model Client {
  id             Int      @id @default(autoincrement())
  name           String
  address        String?  @db.Text
  gstin          String?
  contactPerson  String?
  phone          String?
  email          String?
  createdById    Int
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quotations Quotation[]

  @@index([name])
  @@map("clients")
}

// ---------- Rate templates (DPD rate schedules / Non-DPD starters) ----------

model RateTemplate {
  id            Int           @id @default(autoincrement())
  name          String
  quotationType QuotationType
  version       Int           @default(1)
  isDefault     Boolean       @default(false)
  isActive      Boolean       @default(true)
  createdById   Int
  createdBy     User          @relation(fields: [createdById], references: [id])
  location      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  components  RateTemplateComponent[]
  quotations  Quotation[]

  @@map("rate_templates")
}

model RateTemplateComponent {
  id              Int           @id @default(autoincrement())
  rateTemplateId  Int
  rateTemplate    RateTemplate  @relation(fields: [rateTemplateId], references: [id], onDelete: Cascade)
  label           String
  componentType   ComponentType
  isTax           Boolean       @default(false)
  fixedValue      Decimal?      @db.Decimal(12, 2)
  percentageValue Decimal?      @db.Decimal(5, 2)
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  textValue       String?       @db.Text
  remark          String?       @db.Text

  containerRates RateTemplateContainerRate[]
  lineItems      QuotationLineItem[]

  @@map("rate_template_components")
}

model RateTemplateContainerRate {
  id                      Int                   @id @default(autoincrement())
  rateTemplateComponentId Int
  component               RateTemplateComponent @relation(fields: [rateTemplateComponentId], references: [id], onDelete: Cascade)
  containerSizeId         Int
  containerSize           ContainerSize         @relation(fields: [containerSizeId], references: [id])
  rateValue               Decimal               @db.Decimal(12, 2)

  @@unique([rateTemplateComponentId, containerSizeId])
  @@map("rate_template_container_rates")
}

// ---------- PDF templates ----------

model PdfTemplate {
  id                   Int            @id @default(autoincrement())
  name                 String
  quotationType        QuotationType?
  logoPath             String?
  primaryColor         String         @default("#1c7ed6")
  secondaryColor       String         @default("#495057")
  fontFamily           String         @default("Inter, sans-serif")
  headerHtml           String?        @db.Text
  footerHtml           String?        @db.Text
  termsAndConditions   String?        @db.Text
  htmlTemplate         String?        @db.Text
  isDefault            Boolean        @default(false)
  isActive             Boolean        @default(true)
  createdById          Int
  createdBy            User           @relation(fields: [createdById], references: [id])
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  quotations Quotation[]

  @@map("pdf_templates")
}

// ---------- Numbering & settings ----------

model QuotationNumberSequence {
  id            Int      @id @default(autoincrement())
  prefix        String
  periodKey     String
  lastSequence  Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([prefix, periodKey])
  @@map("quotation_number_sequences")
}

model SmtpSetting {
  id            Int      @id @default(1)
  host          String?
  port          Int?
  username      String?
  passwordEnc   String?
  fromAddress   String?
  fromName      String?
  isConfigured  Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@map("smtp_settings")
}

// ---------- Quotations ----------

model Quotation {
  id                     Int             @id @default(autoincrement())
  quotationNumber        String          @unique
  quotationType          QuotationType
  status                 QuotationStatus @default(DRAFT)

  clientId               Int?
  client                 Client?         @relation(fields: [clientId], references: [id])
  clientName             String
  clientAddress          String?         @db.Text
  clientGstin            String?
  clientContactPerson    String?
  clientPhone            String?
  clientEmail            String?

  rateTemplateId         Int?
  rateTemplate           RateTemplate?   @relation(fields: [rateTemplateId], references: [id])
  pdfTemplateId          Int?
  pdfTemplate            PdfTemplate?    @relation(fields: [pdfTemplateId], references: [id])
  location               String?
  route                  String?
  title                  String?
  customFields           Json?
  servicesOffered        String?
  commodityType           String?
  containerDetails       String?
  additionalRemarks      String?         @db.Text





  subtotal               Decimal         @db.Decimal(12, 2)
  taxTotal               Decimal         @db.Decimal(12, 2)
  otherAdjustmentsTotal  Decimal         @db.Decimal(12, 2) @default(0)
  grandTotal             Decimal         @db.Decimal(12, 2)

  notes                  String?         @db.Text

  createdById            Int
  createdBy              User            @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  submittedAt            DateTime?
  approvedById           Int?
  approvedBy             User?           @relation("QuotationApprovedBy", fields: [approvedById], references: [id])
  approvedAt             DateTime?
  sentAt                 DateTime?

  isDeleted              Boolean         @default(false)
  deletedAt              DateTime?

  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  containers      QuotationContainer[]
  lineItems       QuotationLineItem[]
  statusHistory   QuotationStatusHistory[]
  notifications   Notification[]

  @@index([status])
  @@index([clientName])
  @@index([createdAt])
  @@map("quotations")
}

model QuotationContainer {
  id                  Int            @id @default(autoincrement())
  quotationId         Int
  quotation           Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  containerSizeId     Int?
  containerSize       ContainerSize? @relation(fields: [containerSizeId], references: [id])
  containerSizeLabel  String
  quantity            Int
  createdAt           DateTime       @default(now())

  @@map("quotation_containers")
}

model QuotationLineItem {
  id                       Int                    @id @default(autoincrement())
  quotationId              Int
  quotation                Quotation              @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  label                    String
  componentType            ComponentType
  isTax                    Boolean                @default(false)
  fixedValue               Decimal?               @db.Decimal(12, 2)
  percentageValue          Decimal?               @db.Decimal(5, 2)
  computedAmount           Decimal                @db.Decimal(12, 2)
  containerBreakdown       Json?
  sourceTemplateComponentId Int?
  sourceTemplateComponent  RateTemplateComponent? @relation(fields: [sourceTemplateComponentId], references: [id])
  sortOrder                Int                    @default(0)
  textValue                String?                @db.Text
  remark                   String?                @db.Text
  createdAt                DateTime               @default(now())

  @@map("quotation_line_items")
}

model QuotationStatusHistory {
  id          Int             @id @default(autoincrement())
  quotationId Int
  quotation   Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  fromStatus  QuotationStatus
  toStatus    QuotationStatus
  changedById Int
  changedBy   User            @relation(fields: [changedById], references: [id])
  comment     String?         @db.Text
  createdAt   DateTime        @default(now())

  @@map("quotation_status_history")
}

model Notification {
  id                  Int              @id @default(autoincrement())
  userId              Int
  user                User             @relation(fields: [userId], references: [id])
  type                NotificationType
  message             String
  relatedQuotationId  Int?
  relatedQuotation    Quotation?       @relation(fields: [relatedQuotationId], references: [id])
  isRead              Boolean          @default(false)
  createdAt           DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model CustomField {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  label        String
  type         String   // TEXT, NUMBER, BOOLEAN, SELECT
  required     Boolean  @default(false)
  options      String?  @db.Text
  isActive     Boolean  @default(true)
  showInPdf    Boolean  @default(true)
  showInFilter Boolean  @default(true)
  showInExport Boolean  @default(true)
  showInList   Boolean  @default(true)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("custom_fields")
}



