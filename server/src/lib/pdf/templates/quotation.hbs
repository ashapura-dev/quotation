<!doctype html>
<html>
<head>
<meta charset="utf-8" />
<style>
  * { box-sizing: border-box; }
  body { font-family: {{fontFamily}}; color: #222; margin: 0; padding: 0 8mm; font-size: 13px; }
  .header { border-bottom: 4px solid {{primaryColor}}; padding-bottom: 12px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: flex-start; }
  .logo { max-height: 60px; max-width: 200px; margin-bottom: 8px; }
  .meta { text-align: right; font-size: 12px; color: {{secondaryColor}}; }
  .meta .number { font-size: 16px; font-weight: bold; color: #222; }
  table { width: 100%; border-collapse: collapse; margin-top: 14px; }
  th, td { padding: 7px 8px; border-bottom: 1px solid #e0e0e0; text-align: left; }
  th { background: #f6f6f6; font-size: 12px; text-transform: uppercase; letter-spacing: 0.03em; color: {{secondaryColor}}; }
  .amount { text-align: right; }
  .totals { margin-top: 14px; width: 280px; margin-left: auto; }
  .totals-row { display: flex; justify-content: space-between; padding: 4px 0; }
  .grand { font-weight: bold; font-size: 15px; border-top: 2px solid {{primaryColor}}; padding-top: 8px; margin-top: 6px; }
  .footer { margin-top: 28px; font-size: 11px; color: {{secondaryColor}}; border-top: 1px solid #e0e0e0; padding-top: 10px; }
  .terms { margin-top: 16px; font-size: 11px; color: #666; white-space: pre-wrap; }
  .client-box { margin-top: 4px; padding: 12px; background: #fafafa; border-radius: 6px; }
  .badge { display: inline-block; padding: 2px 10px; border-radius: 4px; background: {{primaryColor}}; color: white; font-size: 11px; margin-top: 4px; }
</style>
</head>
<body>
  <div class="header">
    <div>
      {{#if logoDataUri}}<img class="logo" src="{{logoDataUri}}" />{{/if}}
      <div>{{{headerHtml}}}</div>
    </div>
    <div class="meta">
      <div class="number">{{quotationNumber}}</div>
      <div>{{quotationType}} Quotation</div>
      <div>{{createdAtFormatted}}</div>
    </div>
  </div>

  <div style="text-align: center; margin-top: 10px; margin-bottom: 15px; border-bottom: 1px solid #e0e0e0; padding-bottom: 8px;">
    <h2 style="margin: 0; color: {{primaryColor}}; font-size: 15px; text-transform: uppercase; letter-spacing: 0.05em;">{{heading}}</h2>
  </div>

  <div class="client-box">
    <strong>{{clientName}}</strong><br/>
    {{#if clientAddress}}{{clientAddress}}<br/>{{/if}}
    {{#if clientContactPerson}}Contact: {{clientContactPerson}}&nbsp;&nbsp;{{/if}}
    {{#if clientPhone}}Phone: {{clientPhone}}&nbsp;&nbsp;{{/if}}
    {{#if clientEmail}}Email: {{clientEmail}}{{/if}}
    {{#if clientGstin}}<br/>GSTIN: {{clientGstin}}{{/if}}
  </div>


  <table>
    <thead>
      <tr>
        <th>Particulars</th>
        <th class="amount">Per 20'</th>
        <th class="amount">Per 40'</th>
      </tr>
    </thead>
    <tbody>
    {{#each lineItems}}
      <tr>
        <td>
          {{this.label}}{{#if this.isTax}} (Tax){{/if}}
        </td>
        <td class="amount">{{this.rate20}}</td>
        <td class="amount">{{this.rate40}}</td>
      </tr>
    {{/each}}
    </tbody>
  </table>


  {{#if notes}}<div class="terms"><strong>Notes:</strong> {{notes}}</div>{{/if}}
  {{#if termsAndConditions}}<div class="terms"><strong>Terms &amp; Conditions:</strong><br/>{{termsAndConditions}}</div>{{/if}}

  <div class="footer">{{{footerHtml}}}</div>
</body>
</html>
